# PostgreSQL connection string for local development.
DATABASE_URL="postgresql://trackingthc_user:trackingthc_password@localhost:5432/trackingthc_v4?schema=public"

# App URL used by auth/callbacks later.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only placeholder. Do not expose real Metrc keys to client code.
METRC_ADAPTER_MODE="fake"
METRC_INTEGRATOR_KEY_REF="env:METRC_INTEGRATOR_API_KEY"
METRC_INTEGRATOR_API_KEY="fake-integrator-key-do-not-use"

# Server-side encryption key placeholder for future credential encryption.
# Generate a real value outside git before storing any real user Metrc API key.
CREDENTIAL_ENCRYPTION_KEY="fake-32-byte-placeholder-do-not-use"
